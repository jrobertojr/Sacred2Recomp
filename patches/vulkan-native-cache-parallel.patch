+void VulkanPipelineCache::InitializeNativePipelineCache(
+    const std::filesystem::path& cache_root, u32 title_id) {
+  std::unique_lock<std::shared_mutex> lock(native_pipeline_cache_mutex_);
+  if (native_pipeline_cache_ != VK_NULL_HANDLE) return;
+  const auto* vd = command_processor_.GetVulkanDevice();
+  const auto& ifn = vd->GetVulkanInstance()->GetFunctions();
+  const auto device = vd->GetDevice();
+  const auto create = reinterpret_cast<PFN_vkCreatePipelineCache>(
+      ifn.vkGetDeviceProcAddr(device, "vkCreatePipelineCache"));
+  native_cache_get_data_ = reinterpret_cast<PFN_vkGetPipelineCacheData>(
+      ifn.vkGetDeviceProcAddr(device, "vkGetPipelineCacheData"));
+  native_cache_destroy_ = reinterpret_cast<PFN_vkDestroyPipelineCache>(
+      ifn.vkGetDeviceProcAddr(device, "vkDestroyPipelineCache"));
+  if (!create || !native_cache_get_data_ || !native_cache_destroy_) return;
+  VkPhysicalDeviceProperties properties{};
+  ifn.vkGetPhysicalDeviceProperties(vd->GetPhysicalDevice(), &properties);
+  constexpr size_t max_bytes = 64 * 1024 * 1024;
+  std::error_code ec;
+  const auto directory = cache_root / "vulkan-native";
+  std::filesystem::create_directories(directory, ec);
+  if (ec) return;
+  native_cache_path_ = directory / std::format("{:08X}-{:08X}-{:08X}-{:08X}.bin",
+      title_id, properties.vendorID, properties.deviceID, properties.driverVersion);
+  std::vector<char> bytes;
+  const auto size = std::filesystem::file_size(native_cache_path_, ec);
+  if (!ec && size >= sizeof(VkPipelineCacheHeaderVersionOne) && size <= max_bytes) {
+    bytes.resize(static_cast<size_t>(size));
+    std::ifstream file(native_cache_path_, std::ios::binary);
+    if (!file.read(bytes.data(), static_cast<std::streamsize>(bytes.size()))) bytes.clear();
+    if (!bytes.empty()) {
+      VkPipelineCacheHeaderVersionOne header{};
+      std::memcpy(&header, bytes.data(), sizeof(header));
+      if (header.headerSize < sizeof(header) || header.headerSize > bytes.size() ||
+          header.headerVersion != VK_PIPELINE_CACHE_HEADER_VERSION_ONE ||
+          header.vendorID != properties.vendorID || header.deviceID != properties.deviceID ||
+          std::memcmp(header.pipelineCacheUUID, properties.pipelineCacheUUID, VK_UUID_SIZE))
+        bytes.clear();
+    }
+  }
+  VkPipelineCacheCreateInfo info{};
+  info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+  info.initialDataSize = bytes.size();
+  info.pInitialData = bytes.empty() ? nullptr : bytes.data();
+  auto result = create(device, &info, nullptr, &native_pipeline_cache_);
+  if (result != VK_SUCCESS && !bytes.empty()) {
+    bytes.clear();
+    info.initialDataSize = 0;
+    info.pInitialData = nullptr;
+    native_pipeline_cache_ = VK_NULL_HANDLE;
+    result = create(device, &info, nullptr, &native_pipeline_cache_);
+  }
+  if (result != VK_SUCCESS) native_pipeline_cache_ = VK_NULL_HANDLE;
+  REXGPU_INFO("S2NATIVE_CACHE init result={} loaded_bytes={}",
+              static_cast<i32>(result), bytes.size());
+}
+
+void VulkanPipelineCache::ShutdownNativePipelineCache() {
+  std::unique_lock<std::shared_mutex> lock(native_pipeline_cache_mutex_);
+  if (native_pipeline_cache_ == VK_NULL_HANDLE) return;
+  const auto device = command_processor_.GetVulkanDevice()->GetDevice();
+  try {
+    size_t size = 0;
+    if (native_cache_get_data_(device, native_pipeline_cache_, &size, nullptr) == VK_SUCCESS &&
+        size && size <= 64 * 1024 * 1024) {
+      std::vector<char> bytes(size);
+      if (native_cache_get_data_(device, native_pipeline_cache_, &size, bytes.data()) == VK_SUCCESS) {
+        auto temporary = native_cache_path_;
+        temporary += std::format(".{:016X}.tmp", reinterpret_cast<uintptr_t>(this));
+        {
+          std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+          file.write(bytes.data(), static_cast<std::streamsize>(size));
+          file.close();
+          if (file) {
+            std::error_code ec;
+            std::filesystem::rename(temporary, native_cache_path_, ec);
+            if (!ec) REXGPU_INFO("S2NATIVE_CACHE saved_bytes={}", size);
+            else REXGPU_WARN("S2NATIVE_CACHE rename failed: {}", ec.message());
+          }
+        }
+        std::error_code ec;
+        std::filesystem::remove(temporary, ec);
+      }
+    }
+  } catch (...) {
+    REXGPU_WARN("S2NATIVE_CACHE save failed; continuing shutdown");
+  }
+  native_cache_destroy_(device, native_pipeline_cache_, nullptr);
+  native_pipeline_cache_ = VK_NULL_HANDLE;
+}
